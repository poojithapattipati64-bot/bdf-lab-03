{
  "info": {
    "_postman_id": "lab3-books-api-collection",
    "name": "Lab 3 - Books REST API",
    "description": "BDF Lab 3 - REST API with search, sort, filters, validation and correct status codes.\nBase URL: http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SUCCESS CASES",
      "item": [
        {
          "name": "1. GET All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"]
            }
          }
        },
        {
          "name": "2. GET Books - Search by Title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books?search_q=harry",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "harry" }
              ]
            }
          }
        },
        {
          "name": "3. GET Books - Sort by Price DESC",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books?order_by=price&order=DESC",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" }
              ]
            }
          }
        },
        {
          "name": "4. GET Books - Price Filter (400-800)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books?min_price=400&max_price=800",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "400" },
                { "key": "max_price", "value": "800" }
              ]
            }
          }
        },
        {
          "name": "5. GET Books - Pagination (limit=3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books?limit=3&offset=0",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "3" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "6. GET Single Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books/2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books", "2"]
            }
          }
        },
        {
          "name": "7. POST Create New Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"price\": 520\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:3000/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"]
            }
          }
        },
        {
          "name": "8. PUT Update Book",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune Updated\",\n  \"author\": \"Frank Herbert\",\n  \"price\": 599\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:3000/books/11",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books", "11"]
            }
          }
        },
        {
          "name": "9. DELETE Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books/11",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books", "11"]
            }
          }
        }
      ]
    },
    {
      "name": "FAILURE CASES",
      "item": [
        {
          "name": "10. GET Book - 404 Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books/999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books", "999"]
            }
          }
        },
        {
          "name": "11. POST - 400 Missing Title",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Someone\",\n  \"price\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:3000/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"]
            }
          }
        },
        {
          "name": "12. POST - 400 Missing Price",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Book\",\n  \"author\": \"Author Name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:3000/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"]
            }
          }
        },
        {
          "name": "13. POST - 400 Invalid Price (non-numeric)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Book\",\n  \"author\": \"Author Name\",\n  \"price\": \"abc\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:3000/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books"]
            }
          }
        },
        {
          "name": "14. DELETE - 404 Not Found",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/books/999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["books", "999"]
            }
          }
        }
      ]
    }
  ]
}
